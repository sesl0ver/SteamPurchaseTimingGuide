{
  "name": "el/steamguide",
  "type": "project",
  "require": {
    "php": ">=8.5",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-redis": "*",
    "guzzlehttp/guzzle": "^7.10",
    "matthiasmullie/minify": "^1.3",
    "php-di/php-di": "^7.1",
    "slim/psr7": "^1.8",
    "slim/slim": "^4.14",
    "slim/twig-view": "^3.4",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
