{
  "name": "steamguide",
  "type": "project",
  "require": {
    "php": ">=8.5",
    "slim/slim": "^4.14",
    "slim/psr7": "^1.8",
    "php-di/php-di": "^7.1",
    "slim/twig-view": "^3.4",
    "vlucas/phpdotenv": "^5.6",
    "ext-pdo": "*",
    "ext-mbstring": "*"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
