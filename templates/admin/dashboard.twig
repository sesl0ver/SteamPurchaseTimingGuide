{% extends 'admin/layout.twig' %}

{% block title %}Admin · Dashboard{% endblock %}
{% block header_title %}대시보드{% endblock %}
{% block nav_dashboard_active %}bg-white/5 border border-white/10{% endblock %}

{% block content %}

{# KPI Row #}
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
  <div class="admin-card rounded-xl p-4">
    <div class="text-xs admin-muted">오늘 DAU</div>
    <div class="mt-1 text-2xl font-semibold">
      {{ dau_delta.today }}
      <span class="text-sm {{ dau_delta.delta >= 0 ? 'text-emerald-400' : 'text-rose-400' }}">
        ({{ dau_delta.delta >= 0 ? '+' : '' }}{{ dau_delta.delta }})
      </span>
    </div>
  </div>

  <div class="admin-card rounded-xl p-4">
    <div class="text-xs admin-muted">현재 CCU</div>
    <div class="mt-1 text-2xl font-semibold">
      {{ ccu_delta.current }}
      <span class="text-sm {{ ccu_delta.delta >= 0 ? 'text-emerald-400' : 'text-rose-400' }}">
        ({{ ccu_delta.delta >= 0 ? '+' : '' }}{{ ccu_delta.delta }})
      </span>
    </div>
  </div>

  <div class="admin-card rounded-xl p-4">
    <div class="text-xs admin-muted">신규/재방문 (오늘)</div>
    <div class="mt-2 text-sm">
      <span class="text-emerald-300">신규 {{ new_vs_return.new }}</span>
      <span class="mx-2 text-white/20">|</span>
      <span class="text-sky-300">재방문 {{ new_vs_return.returning }}</span>
      <div class="mt-1 text-xs admin-muted">총 {{ new_vs_return.total }}</div>
    </div>
  </div>

  <div class="admin-card rounded-xl p-4">
    <div class="text-xs admin-muted">D1 Retention</div>
    <div class="mt-1 text-2xl font-semibold">{{ retention_d1.rate }}%</div>
    <div class="mt-1 text-xs admin-muted">{{ retention_d1.cohort_day }} → {{ retention_d1.returned }}/{{ retention_d1.cohort_size }}</div>
  </div>
</div>

{# DAU mini chart #}
<section class="admin-card rounded-xl p-4">
  <div class="flex items-end justify-between">
    <div>
      <div class="text-sm font-semibold">DAU (최근 7일)</div>
      <div class="text-xs admin-muted">단순 추세 확인용</div>
    </div>
  </div>
  <div class="mt-4 grid grid-cols-7 gap-2 text-sm">
    {% for day, count in dau %}
      <div class="rounded-lg border border-white/5 bg-white/[0.03] p-2 text-center">
        <div class="text-[11px] admin-muted">{{ day }}</div>
        <div class="text-lg font-semibold">{{ count }}</div>
      </div>
    {% endfor %}
  </div>
</section>

<div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
  {# Trending #}
  <section class="admin-card rounded-xl p-4">
    <div class="flex items-end justify-between">
      <div>
        <div class="text-sm font-semibold">Trending (7일)</div>
        <div class="text-xs admin-muted">조회 상위</div>
      </div>
    </div>

    <div class="mt-4 overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="text-left text-xs admin-muted">
          <tr>
            <th class="py-2 pr-2">#</th>
            <th class="py-2 pr-2">Kind</th>
            <th class="py-2 pr-2">ID</th>
            <th class="py-2 pr-2">제목</th>
            <th class="py-2 text-right">조회수</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/5">
          {% for item in trending %}
            <tr>
              <td class="py-2 pr-2 text-xs admin-muted">{{ loop.index }}</td>
              <td class="py-2 pr-2">{{ item.kind }}</td>
              <td class="py-2 pr-2 font-mono text-xs">{{ item.id }}</td>
              <td class="py-2 pr-2">{{ item.title ?? '(unknown)' }}</td>
              <td class="py-2 text-right font-semibold">{{ item.count }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>

  {# Events + focus #}
  <div class="space-y-6">
    <section class="admin-card rounded-xl p-4">
      <div class="text-sm font-semibold">트렌딩 집중도 (Top 5)</div>
      <div class="text-xs admin-muted">Top5 비중</div>
      <ul class="mt-3 space-y-2 text-sm">
        {% for item in trending_focus %}
          <li class="flex items-center justify-between rounded-lg border border-white/5 bg-white/[0.03] px-3 py-2">
            <span class="truncate">#{{ item.rank }} {{ item.title ?? '(unknown)' }}</span>
            <span class="text-xs admin-muted shrink-0">{{ item.ratio }}%</span>
          </li>
        {% else %}
          <li class="text-sm admin-muted">데이터 없음</li>
        {% endfor %}
      </ul>
    </section>

    <section class="admin-card rounded-xl p-4">
      <div class="text-sm font-semibold">Events (최근 3일)</div>
      <div class="mt-3 space-y-3">
        {% for day, events in events %}
          <div>
            <div class="text-xs admin-muted">{{ day }}</div>
            <ul class="mt-2 space-y-1 text-sm">
              {% for name, cnt in events %}
                <li class="flex items-center justify-between">
                  <span class="truncate">{{ name }}</span>
                  <span class="font-mono text-xs admin-muted">{{ cnt }}</span>
                </li>
              {% else %}
                <li class="text-sm admin-muted">이벤트 없음</li>
              {% endfor %}
            </ul>
          </div>
        {% endfor %}
      </div>
    </section>
  </div>
</div>

{% endblock %}
