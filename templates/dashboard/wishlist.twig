{% extends "layout.twig" %}

{% block title %}찜 목록 관리{% endblock %}

{% block content %}
  <div class="mx-auto max-w-5xl px-4 py-10">

    {% include "partials/header.twig" %}

    <div class="flex flex-col gap-6 sm:flex-row">

      {# =========================
           좌측 영역 (1/3)
           ========================= #}
      <aside class="sm:w-1/3">
        <div class="rounded-3xl border border-white/10 bg-white/[0.03] p-6">
          {# 프로필 #}
          <div class="flex items-center gap-4">
            <img
                    src="{{ steam_user.avatar_medium }}"
                    alt="Steam avatar"
                    class="h-16 w-16 rounded-full border border-white/10"
            />
            <div>
              <div class="text-base font-semibold text-white">
                {{ steam_user.persona_name }}
              </div>
              <a
                      href="https://steamcommunity.com/profiles/{{ steam_user.steam_id }}/"
                      target="_blank"
                      rel="noopener"
                      class="text-xs text-emerald-300 hover:text-emerald-200"
              >
                Steam 프로필 보기 →
              </a>
            </div>
          </div>

          {# 구분선 #}
          <div class="my-5 h-px bg-white/10"></div>

          {# 메뉴 #}
          <nav class="space-y-2 text-sm">
            <a
                    href="/dashboard"
                    class="block rounded-xl px-3 py-2 text-white/70 hover:bg-white/[0.06]"
            >
              대시보드
            </a>

            <a
                    href="/dashboard/wishlist"
                    class="block rounded-xl px-3 py-2 bg-white/[0.06] text-white"
            >
              찜 목록 관리
            </a>
          </nav>

        </div>
      </aside>

      {# =========================
           우측 영역 (2/3)
           ========================= #}
      <section class="sm:w-2/3 space-y-6">

        <div class="rounded-3xl border border-white/10 bg-white/[0.03] p-6">
          <div class="flex items-end justify-between">
            <div>
              <h3 class="text-lg font-semibold text-white">찜 목록 관리</h3>
              <p class="mt-1 text-xs text-white/50">너무 길어지는 것을 방지하기 위해 페이지 단위로 표시합니다.</p>
            </div>
            <span class="text-xs text-white/50">총 {{ wishlist_total }}개</span>
          </div>

          {% if wishlist is empty %}
            <p class="mt-3 text-sm text-white/60">
              아직 찜한 게임이 없습니다. 홈에서 하트 버튼으로 찜할 수 있어요.
            </p>
          {% else %}
            <div class="mt-4 space-y-3">
              {% for item in wishlist %}
                <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-4">
                  <div class="flex gap-4">
                    <div class="w-24 shrink-0">
                      {% if item.header_image %}
                        <img src="{{ item.header_image }}" alt="{{ item.title|e }}" class="h-16 w-24 rounded-xl object-cover border border-white/10" />
                      {% else %}
                        <div class="h-16 w-24 rounded-xl bg-black/30 border border-white/10 grid place-items-center text-[11px] text-white/40">이미지 없음</div>
                      {% endif %}
                    </div>

                    <div class="flex-1 min-w-0">
                      <div class="flex items-center gap-2">
                        <a href="{{ item.steam_url }}" target="_blank" rel="noopener" class="font-semibold text-white/90 hover:text-white">
                          {{ item.title }}
                        </a>
                        <span class="inline-flex items-center rounded-full border border-white/10 bg-white/[0.06] px-2 py-0.5 text-[11px] text-white/70">
                          {{ item.kind|upper }}
                        </span>
                      </div>
                      <p class="mt-1 text-xs text-white/55">추가일: {{ item.created_at|date("Y-m-d") }}</p>
                    </div>

                    <div class="shrink-0">
                      <form method="post" action="/dashboard/wishlist/remove" onsubmit="return confirm('찜을 취소하시겠습니까?');">
                        <input type="hidden" name="kind" value="{{ item.kind }}" />
                        <input type="hidden" name="id" value="{{ item.item_id }}" />
                        <input type="hidden" name="return_url" value="/dashboard/wishlist?page={{ page }}" />
                        <button type="submit" class="rounded-xl border border-white/15 px-3 py-2 text-xs font-semibold text-white/80 hover:bg-white/[0.06]">
                          찜 취소
                        </button>
                      </form>
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>

            {# 페이지네이션 #}
            {% if total_pages > 1 %}
              <div class="mt-6 flex items-center justify-between">
                <div class="text-xs text-white/50">
                  {{ page }} / {{ total_pages }} 페이지
                </div>

                <div class="flex items-center gap-2">
                  {% set prev = page - 1 %}
                  {% set next = page + 1 %}

                  {# 번호 버튼 표시 범위(너무 길어지지 않게 현재 기준 ±2) #}
                  {% set window = 2 %}
                  {% set start = page - window %}
                  {% set end = page + window %}
                  {% if start < 1 %}{% set start = 1 %}{% endif %}
                  {% if end > total_pages %}{% set end = total_pages %}{% endif %}

                  <a
                          href="/dashboard/wishlist?page={{ prev }}"
                          class="rounded-xl border border-white/10 bg-white/[0.03] px-3 py-2 text-xs text-white/70 hover:bg-white/[0.06] {{ page <= 1 ? 'pointer-events-none opacity-40' : '' }}"
                  >이전</a>

                  {# 첫 페이지가 범위 밖이면 1과 … 표시 #}
                  {% if start > 1 %}
                    <a
                            href="/dashboard/wishlist?page=1"
                            class="rounded-xl border border-white/10 bg-white/[0.03] px-3 py-2 text-xs text-white/70 hover:bg-white/[0.06]"
                    >1</a>
                    {% if start > 2 %}
                      <span class="px-1 text-xs text-white/40">…</span>
                    {% endif %}
                  {% endif %}

                  {# 가운데 번호 버튼 #}
                  {% for p in start..end %}
                    <a
                            href="/dashboard/wishlist?page={{ p }}"
                            class="rounded-xl border border-white/10 px-3 py-2 text-xs hover:bg-white/[0.06] {{ p == page ? 'bg-white/[0.10] text-white' : 'bg-white/[0.03] text-white/70' }}"
                    >{{ p }}</a>
                  {% endfor %}

                  {# 마지막 페이지가 범위 밖이면 … 과 마지막 번호 표시 #}
                  {% if end < total_pages %}
                    {% if end < total_pages - 1 %}
                      <span class="px-1 text-xs text-white/40">…</span>
                    {% endif %}
                    <a
                            href="/dashboard/wishlist?page={{ total_pages }}"
                            class="rounded-xl border border-white/10 bg-white/[0.03] px-3 py-2 text-xs text-white/70 hover:bg-white/[0.06]"
                    >{{ total_pages }}</a>
                  {% endif %}

                  <a
                          href="/dashboard/wishlist?page={{ next }}"
                          class="rounded-xl border border-white/10 bg-white/[0.03] px-3 py-2 text-xs text-white/70 hover:bg-white/[0.06] {{ page >= total_pages ? 'pointer-events-none opacity-40' : '' }}"
                  >다음</a>
                </div>
              </div>
            {% endif %}
          {% endif %}
        </div>

      </section>
    </div>
  </div>
{% endblock %}
