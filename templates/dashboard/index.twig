{% extends "layout.twig" %}

{% block title %}유저 대시보드{% endblock %}

{% block content %}
  <div class="mx-auto max-w-5xl px-4 py-10">

    {% include "partials/header.twig" %}

    <div class="flex flex-col gap-6 sm:flex-row">

      {# =========================
           좌측 영역 (1/3)
           ========================= #}
      <aside class="sm:w-1/3">
        <div class="rounded-3xl border border-white/10 bg-white/[0.03] p-6">
          {# 프로필 #}
          <div class="flex items-center gap-4">
            <img
                    src="{{ steam_user.avatar_medium }}"
                    alt="Steam avatar"
                    class="h-16 w-16 rounded-full border border-white/10"
            />
            <div>
              <div class="text-base font-semibold text-white">
                {{ steam_user.persona_name }}
              </div>
              <a
                      href="https://steamcommunity.com/profiles/{{ steam_user.steam_id }}/"
                      target="_blank"
                      rel="noopener"
                      class="text-xs text-emerald-300 hover:text-emerald-200"
              >
                Steam 프로필 보기 →
              </a>
            </div>
          </div>

          {# 구분선 #}
          <div class="my-5 h-px bg-white/10"></div>

          {# 메뉴 #}
          <nav class="space-y-2 text-sm">
            <a
                    href="/dashboard"
                    class="block rounded-xl px-3 py-2
                               bg-white/[0.06] text-white"
            >
              대시보드
            </a>

            {# 향후 메뉴 확장 여지 #}
            {#
            <a href="#" class="block rounded-xl px-3 py-2 text-white/70 hover:bg-white/[0.06]">
                설정
            </a>
            #}
          </nav>

        </div>
      </aside>

      {# =========================
           우측 영역 (2/3)
           ========================= #}
      <section class="sm:w-2/3 space-y-6">

        {# 내 정보 카드 #}
        <div class="rounded-3xl border border-white/10 bg-white/[0.03] p-6">
          <h3 class="text-lg font-semibold text-white">내 계정 정보</h3>

          <dl class="mt-4 space-y-3 text-sm">
            <div class="flex justify-between gap-4">
              <dt class="text-white/60">Steam ID</dt>
              <dd class="font-mono text-white/85">
                {{ steam_user.steam_id }}
              </dd>
            </div>

            <div class="flex justify-between gap-4">
              <dt class="text-white/60">최근 로그인</dt>
              <dd class="text-white/85">
                {{ steam_user.last_login_at | date("Y-m-d H:i:s") }}
              </dd>
            </div>
          </dl>
        </div>

        {# =========================
             찜 목록
             ========================= #}
        <div class="rounded-3xl border border-white/10 bg-white/[0.03] p-6">
          <div class="flex items-end justify-between">
            <h3 class="text-lg font-semibold text-white">찜 목록</h3>
            <span class="text-xs text-white/50">총 {{ wishlist|length }}개</span>
          </div>

          {% if wishlist is empty %}
            <p class="mt-3 text-sm text-white/60">
              아직 찜한 게임이 없습니다. 홈에서 하트 버튼으로 찜할 수 있어요.
            </p>
          {% else %}
            <div class="mt-4 space-y-3">
              {% for item in wishlist %}
                <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-4">
                  <div class="flex gap-4">
                    <div class="w-24 shrink-0">
                      {% if item.header_image %}
                        <img src="{{ item.header_image }}" alt="{{ item.title|e }}" class="h-16 w-24 rounded-xl object-cover border border-white/10" />
                      {% else %}
                        <div class="h-16 w-24 rounded-xl bg-black/30 border border-white/10 grid place-items-center text-[11px] text-white/40">이미지 없음</div>
                      {% endif %}
                    </div>

                    <div class="flex-1 min-w-0">
                      <div class="flex items-center gap-2">
                        <a href="{{ item.steam_url }}" target="_blank" rel="noopener" class="font-semibold text-white/90 hover:text-white">
                          {{ item.title }}
                        </a>
                        <span class="inline-flex items-center rounded-full border border-white/10 bg-white/[0.06] px-2 py-0.5 text-[11px] text-white/70">
                          {{ item.kind|upper }}
                        </span>
                      </div>
                      <p class="mt-1 text-xs text-white/55">추가일: {{ item.created_at|date("Y-m-d") }}</p>
                    </div>

                    <div class="shrink-0">
                      <form method="post" action="/dashboard/wishlist/remove" onsubmit="return confirm('찜을 취소하시겠습니까?');">
                        <input type="hidden" name="kind" value="{{ item.kind }}" />
                        <input type="hidden" name="id" value="{{ item.item_id }}" />
                        <button type="submit" class="rounded-xl border border-white/15 px-3 py-2 text-xs font-semibold text-white/80 hover:bg-white/[0.06]">
                          찜 취소
                        </button>
                      </form>
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>
          {% endif %}
        </div>

        {# 회원 탈퇴 카드 #}
        <div class="rounded-3xl border border-red-400/30 bg-red-400/5 p-6">
          <h3 class="text-lg font-semibold text-red-300">
            회원 탈퇴
          </h3>

          <p class="mt-2 text-sm text-red-200/80 leading-relaxed">
            회원 탈퇴 시 계정과 관련된 모든 정보는 즉시 삭제됩니다.<br />
            탈퇴 후에도 동일한 Steam 계정으로 재가입이 가능합니다.
          </p>

          <form
                  method="post"
                  action="/auth/withdraw"
                  class="mt-4"
                  onsubmit="return confirm('정말로 회원 탈퇴하시겠습니까?\n탈퇴 시 모든 정보는 즉시 삭제되며, 이 작업은 되돌릴 수 없습니다.');"
          >
            <button
                    type="submit"
                    class="rounded-xl border border-red-400/40 px-4 py-2
                               text-sm font-semibold text-red-300
                               transition-colors hover:bg-red-400/10"
            >
              회원 탈퇴 진행
            </button>
          </form>
        </div>

      </section>
    </div>
  </div>
{% endblock %}
