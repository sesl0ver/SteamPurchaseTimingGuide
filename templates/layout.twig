{# templates/layout.twig #}
<!doctype html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{% block title %}Steam 구매 추천 도우미{% endblock %}</title>

    <meta name="description" content="가격, 할인, 역대 최저가 데이터를 기반으로 지금 사도 되는지 판단만 도와드립니다.">

    <meta name="google-site-verification" content="qFcIcTDfj86WKD1VMfalr3UzUSGJZcwwK8yYq4bZ1e8" />

    <link rel="canonical" href="https://buyornot.sesl0ver.dev/">

    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta property="og:title" content="Steam 구매 추천 도우미">
    <meta property="og:description" content="Steam 가격 데이터 기반으로 정리해드립니다.">
    <meta property="og:url" content="https://buyornot.sesl0ver.dev">

    <!-- Twitter (X) -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Steam 구매 추천 도우미">
    <meta name="twitter:description" content="Steam 가격 데이터 기반으로 정리해드립니다.">

    <link rel="stylesheet" href="/assets/app.min.css" />
    <style>
        /* ===== Tone presets (pure CSS, unified green for positive) ===== */

        /* 가격(할인율) */
        .tone-price-high{border-color:rgba(52,211,153,.36);background-color:rgba(16,185,129,.10);}
        .tone-price-mid{border-color:rgba(52,211,153,.28);background-color:rgba(16,185,129,.08);}
        .tone-price-low{border-color:rgba(255,255,255,.16);background-color:rgba(255,255,255,.035);}
        .tone-price-none{border-color:rgba(255,255,255,.10);background-color:rgba(255,255,255,.02);}

        /* 가격 이력 */
        .tone-history-lowest{border-color:rgba(52,211,153,.36);background-color:rgba(16,185,129,.10);} /* 역대 최저가 = 긍정(녹색) */
        .tone-history-known{border-color:rgba(148,163,184,.30);background-color:rgba(148,163,184,.07);} /* 이력 있음(최저 아님) = 중립(slate) */
        .tone-history-unknown{border-color:rgba(255,255,255,.10);background-color:rgba(255,255,255,.02);} /* 이력 불충분 = 기본 */

        /* 유저 반응 */
        .tone-review-high{border-color:rgba(52,211,153,.28);background-color:rgba(16,185,129,.08);}
        .tone-review-mid{border-color:rgba(148,163,184,.26);background-color:rgba(148,163,184,.06);}
        .tone-review-low{border-color:rgba(251,113,133,.28);background-color:rgba(244,63,94,.08);}
        .tone-review-unknown{border-color:rgba(255,255,255,.10);background-color:rgba(255,255,255,.02);}

        /* 할인 기간 */
        .tone-sale-on{border-color:rgba(52,211,153,.24);background-color:rgba(16,185,129,.06);} /* 진행 중(여유) = 녹색 */
        .tone-sale-soon{border-color:rgba(252,211,77,.32);background-color:rgba(251,191,36,.09);} /* 1~2일 남음 = 주의(amber) */
        .tone-sale-today{border-color:rgba(253,164,175,.34);background-color:rgba(251,113,133,.10);} /* 오늘 종료 = 경고(rose) */
        .tone-sale-off{border-color:rgba(255,255,255,.10);background-color:rgba(255,255,255,.02);} /* 정보 없음/미할인 = 기본 */

        /* 선택: 강조 카드 인셋 라인 */
        .tone-price-high,.tone-price-mid,.tone-history-lowest,.tone-history-known,.tone-review-high,.tone-review-mid,.tone-review-low,.tone-sale-on,.tone-sale-soon,.tone-sale-today{box-shadow:inset 0 0 0 1px rgba(255,255,255,.06);}

        /* 기존 스타일들 */
        html { scroll-behavior: smooth; }
        @keyframes wave {
            0%   { transform: translateY(0); opacity: .6; }
            30%  { transform: translateY(-6px); opacity: 1; }
            60%  { transform: translateY(0); opacity: .8; }
            100% { opacity: .6; }
        }
        .loading-wave { display: inline-block; animation: wave 1.4s ease-in-out infinite; }
        .loading-wave:nth-child(1)  { animation-delay: 0s; }
        .loading-wave:nth-child(2)  { animation-delay: .05s; }
        .loading-wave:nth-child(3)  { animation-delay: .1s; }
        .loading-wave:nth-child(4)  { animation-delay: .15s; }
        .loading-wave:nth-child(5)  { animation-delay: .2s; }
        .loading-wave:nth-child(6)  { animation-delay: .25s; }
        .loading-wave:nth-child(7)  { animation-delay: .3s; }
        .loading-wave:nth-child(8)  { animation-delay: .35s; }
        .loading-wave:nth-child(9)  { animation-delay: .4s; }
        .loading-wave:nth-child(10) { animation-delay: .45s; }
        .loading-wave:nth-child(11) { animation-delay: .5s; }
        .loading-wave:nth-child(12) { animation-delay: .55s; }
        .loading-wave:nth-child(13) { animation-delay: .6s; }
        .loading-wave:nth-child(14) { animation-delay: .65s; }
        .loading-wave:nth-child(15) { animation-delay: .7s; }

        /* 스크롤바 숨김 (모든 브라우저 대응) */
        .scrollbar-hidden {
            -ms-overflow-style: none; /* IE, Edge */
            scrollbar-width: none;    /* Firefox */
        }
        .scrollbar-hidden::-webkit-scrollbar {
            display: none;            /* Chrome, Safari */
        }

        .trend-arrow {
            position: absolute;
            top: 0;
            bottom: 0;
            width: 56px;
            z-index: 10;

            display: flex;
            align-items: center;
            justify-content: center;

            font-size: 28px;
            font-weight: 600;

            color: rgba(255,255,255,0.6);
            background: linear-gradient(
                    to right,
                    rgba(10,10,15,0.65),
                    rgba(10,10,15,0)
            );

            cursor: pointer;
            transition: all .2s ease;
            opacity: 0;
            pointer-events: auto;
        }

        .trend-arrow.right-0 {
            background: linear-gradient(
                    to left,
                    rgba(10,10,15,0.80),
                    rgba(10,10,15,0)
            );
        }

        .trend-arrow:hover {
            color: rgba(0,200,0,0.9);
        }
        #trendingWrap .trend-arrow {
            opacity: 0;
        }
        #trendingWrap:hover .trend-arrow {
            opacity: 1;
        }
        #trendingWrap { position: relative; }
        #trendingScroller { position: relative; }
    </style>
</head>

<body class="min-h-dvh bg-neutral-950 text-neutral-100">
{# 배경 장식(가벼운 그라데이션 + 노이즈 느낌) #}
<div aria-hidden="true" class="pointer-events-none fixed inset-0">
    <div class="absolute inset-0 bg-[radial-gradient(1200px_circle_at_20%_15%,rgba(59,130,246,0.18),transparent_55%),radial-gradient(900px_circle_at_80%_20%,rgba(168,85,247,0.14),transparent_50%),radial-gradient(800px_circle_at_55%_85%,rgba(16,185,129,0.10),transparent_55%)]"></div>
    <div class="absolute inset-0 opacity-[0.06] bg-[linear-gradient(to_right,rgba(255,255,255,0.12)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.12)_1px,transparent_1px)] [background-size:48px_48px]"></div>
</div>

<main class="relative">
    {% block content %}{% endblock %}
</main>

<footer class="relative mt-12 border-t border-white/5">
    <div class="mx-auto max-w-5xl px-4 py-6 text-center">

        <p class="text-xs text-white/40 leading-relaxed">
            본 서비스는 Valve 또는 Steam의 공식 서비스가 아니며,
            Valve Corporation과 제휴·후원·승인을 받지 않았습니다.<br />
            “Steam” 및 관련 표기는 Valve Corporation의 상표 또는 등록 상표일 수 있습니다.
        </p>

        <p class="mt-2 text-[11px] text-white/35">
            본 페이지의 정보는 참고용이며, 구매 결정은 사용자 본인에게 있습니다.
        </p>

        <p class="mt-4 text-[11px] text-white/30">
            © {{ "now"|date("Y") }} Steam Purchase Timing Guide
            <span class="mx-2 text-white/20">|</span>
            contact :
            <a
                    href="mailto:support@sesl0ver.dev"
                    class="underline underline-offset-2 hover:text-white/50"
            >
                support@sesl0ver.dev
            </a>
        </p>


    </div>
</footer>



{% block scripts %}{% endblock %}
</body>
</html>
