{# templates/layout.twig #}
<!doctype html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% block title %}Steam 구매 추천 도우미{% endblock %}</title>

    {# Tailwind v4 build 결과물 CSS를 연결하세요 #}
    <link rel="stylesheet" href="/assets/app.css" />
    <style>
        html {
            scroll-behavior: smooth;
        }
    </style>

    {# 필요 시 폰트/아이콘은 여기서 추가 #}
</head>

<body class="min-h-dvh bg-neutral-950 text-neutral-100">
{# 배경 장식(가벼운 그라데이션 + 노이즈 느낌) #}
<div aria-hidden="true" class="pointer-events-none fixed inset-0">
    <div class="absolute inset-0 bg-[radial-gradient(1200px_circle_at_20%_15%,rgba(59,130,246,0.18),transparent_55%),radial-gradient(900px_circle_at_80%_20%,rgba(168,85,247,0.14),transparent_50%),radial-gradient(800px_circle_at_55%_85%,rgba(16,185,129,0.10),transparent_55%)]"></div>
    <div class="absolute inset-0 opacity-[0.06] bg-[linear-gradient(to_right,rgba(255,255,255,0.12)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.12)_1px,transparent_1px)] [background-size:48px_48px]"></div>
</div>

<main class="relative">
    {% block content %}{% endblock %}
</main>

<footer class="relative border-t border-white/10">
    {# 은은한 배경 처리 #}
    <div aria-hidden="true" class="pointer-events-none absolute inset-0">
        <div class="absolute inset-0 bg-[radial-gradient(900px_circle_at_50%_-20%,rgba(255,255,255,0.06),transparent_60%)]"></div>
    </div>

    <div class="relative mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
        <div class="flex flex-col gap-10 lg:flex-row lg:items-start lg:justify-between">

            {# 좌측: 라이선스 고지 (톤 다운) #}
            <div class="max-w-3xl">
                <p class="text-sm font-semibold text-white/70">
                    Steam / 라이선스 고지
                </p>
                <p class="mt-3 text-sm leading-relaxed text-white/55">
                    본 서비스는 Valve 또는 Steam의 공식 서비스가 아니며,
                    Valve Corporation과 제휴·후원·승인을 받지 않았습니다.
                    “Steam” 및 관련 표기는 Valve Corporation의 상표 또는 등록 상표일 수 있습니다.
                </p>
                <p class="mt-3 text-xs leading-relaxed text-white/45">
                    본 페이지의 추천 결과는 정보 제공 목적이며, 구매 결정을 강요하지 않습니다.
                </p>
            </div>

            {# 우측: 카피라이트 (카드 제거 → 텍스트화) #}
            <div class="text-sm text-white/55 lg:text-right">
                <p class="font-medium text-white/70">© {{ "now"|date("Y") }}</p>
                <p class="mt-1">
                    Steam Purchase Assistant Tool
                </p>
                <p class="mt-2 text-xs text-white/45">
                    All rights reserved.
                </p>
            </div>
        </div>

        {# 최하단 여백 + 종결선 #}
        <div class="mt-10 flex items-center justify-center">
            <span class="h-px w-24 bg-white/10"></span>
        </div>
    </div>
</footer>


{% block scripts %}{% endblock %}
</body>
</html>
