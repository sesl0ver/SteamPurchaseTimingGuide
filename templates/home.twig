{% extends "layout.twig" %}
{% block title %}Steam 구매 시점 가이드{% endblock %}

{% block content %}

    <div class="mx-auto max-w-5xl px-4 py-10">

        {% include "partials/header.twig" %}

        <section class="rounded-3xl border border-white/10 bg-white/[0.03] p-6 sm:p-8">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
                <div>
                    <h2 class="text-lg font-semibold text-white">구매 여부를 고민 중인 게임이 있나요?</h2>
                    <p class="mt-1 text-sm text-white/60">
                        Steam 앱 ID 또는 스토어 주소를 그대로 붙여 넣고 버튼을 눌러주세요.
                    </p>
                </div>

                {# ✅ 찜 목록에서 선택 (로그인 시) #}
                {% if steam_user %}
                  <div class="sm:self-center">
                    <button
                            id="wishlistSelectBtn"
                            type="button"
                            class="rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-2.5 text-sm font-semibold text-white/80 transition-colors hover:bg-white/[0.06]"
                    >
                      찜 목록에서 선택
                    </button>
                  </div>
                {% endif %}
            </div>

            <div class="mt-4 flex flex-col gap-3 sm:flex-row">
                <input
                        id="appId"
                        type="text"
                        inputmode="url"
                        autocomplete="off"
                        placeholder="Steam 스토어 주소 또는 App ID를 입력하세요"
                        class="flex-1 rounded-2xl border border-white/10 bg-black/30 px-4 py-3 text-white placeholder:text-white/40 focus:border-white/20 focus:outline-none"
                />
                <button
                        id="fetchDealBtn"
                        type="button"
                        class="rounded-2xl bg-white px-6 py-3 text-sm font-semibold text-neutral-950 hover:bg-white/90"
                >
                    구매 정보 살펴보기
                </button>
            </div>

            <section id="resultArea" class="mt-8 space-y-4">
                {# 게임 헤더 #}
                <div id="gameHeader" class="hidden"></div>

                {# 결과 카드(초기 상태) #}
                <div id="resultCards" class="rounded-2xl border border-white/10 bg-white/[0.02] p-5">
                    <p class="text-sm font-semibold text-white/85">아직 확인한 게임이 없습니다</p>
                    <p class="mt-1 text-xs text-white/60">
                        위에 Steam 스토어 주소를 붙여넣어 보세요.<br />
                        가격, 할인 이력, 리뷰 흐름을 한 번에 정리해 드립니다.
                    </p>
                </div>
            </section>
        </section>

        <section id="trendingSection" class="mt-8 hidden">
            <div class="flex items-end justify-between mb-3">
                <div>
                    <h2 class="text-base font-semibold">👀 최근에 살펴본 게임</h2>
                </div>
            </div>

            <!-- 래퍼(overlay 기준) -->
            <div id="trendingWrap" class="relative overflow-hidden">
                <!-- 스크롤 컨테이너(항상 동일) -->
                <div id="trendingScroller" class="-mx-1 overflow-x-auto scrollbar-hidden">
                    <div id="trendingList" class="flex gap-3 min-w-max snap-x snap-mandatory pb-2 px-1"></div>
                </div>
            </div>
        </section>

        {# 안내 (문단형 + 항목별 분리) #}
        <section class="mt-6 rounded-3xl border border-white/10 bg-white/[0.03] p-6 sm:p-8">
            <div class="flex items-start gap-3">
                <div class="grid size-10 place-items-center rounded-2xl bg-white/10 ring-1 ring-white/10">ℹ️</div>
                <div>
                    <h2 class="text-lg font-semibold text-white">이 서비스는 무엇인가요?</h2>
                    <p class="mt-1 text-sm text-white/60">
                        가격·리뷰·이력을 정리해 구매 시점을 판단하는 데 필요한 정보를 제공합니다.
                    </p>
                </div>
            </div>

            {# ✅ 안내 리스트 (불릿 정렬 개선 버전) #}
            <div class="mt-6 space-y-3">
                {# item #}
                <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-4">
                    <div class="flex items-start gap-3">
                        <span class="mt-[2px] text-white/60 leading-none select-none">•</span>
                        <p class="text-sm leading-relaxed text-white/75">
                            본 서비스는 Steam 게임의 가격·할인·가격 이력·리뷰 요약 등 공개 데이터를 정리해,
                            구매 판단에 필요한 정보를 제공합니다.
                        </p>
                    </div>
                </div>

                <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-4">
                    <div class="flex items-start gap-3">
                        <span class="mt-[2px] text-white/60 leading-none select-none">•</span>
                        <p class="text-sm leading-relaxed text-white/75">
                            본 서비스는 정보 제공 목적으로 운영되며, 이를 기반으로 한 구매 결정과 결과에 대한 책임은 사용자 본인에게 있습니다.
                        </p>
                    </div>
                </div>

                <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-4">
                    <div class="flex items-start gap-3">
                        <span class="mt-[2px] text-white/60 leading-none select-none">•</span>
                        <p class="text-sm leading-relaxed text-white/75">
                            본 서비스는 특정 게임의 구매를 권장하거나 억제하려는 목적이 아닙니다.
                            개인 취향, 플레이 목적, 선호 장르, 기대치 등은 반영되지 않을 수 있습니다.
                        </p>
                    </div>
                </div>

                {# ✅ 추가: 유저 한글패치 안내 #}
                <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-4">
                    <div class="flex items-start gap-3">
                        <span class="mt-[2px] text-white/60 leading-none select-none">•</span>
                        <p class="text-sm leading-relaxed text-white/75">
                            유저 한글패치는 비공식 자료이며, 모든 환경에서 동작을 보장하지 않습니다.
                            패치 제작 시기, 게임 버전/업데이트, DLC 보유 여부, 모드/설정 충돌 등에 따라 적용 결과가 달라질 수 있습니다.
                            설치 전에는 제공처의 적용 대상 버전, 설치 방법, 요구 조건과 주의사항을 확인해 주세요.
                            또한 외부 실행 파일/런처를 요구하는 자료는 보안 위험이 있을 수 있으니 출처 신뢰도를 점검해 주세요.
                        </p>
                    </div>
                </div>

                {# ✅ 추가: 제작자 요청 시 비표기 안내 #}
                <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-4">
                    <div class="flex items-start gap-3">
                        <span class="mt-[2px] text-white/60 leading-none select-none">•</span>
                        <p class="text-sm leading-relaxed text-white/75">
                            유저 한글패치 정보는 참고용으로만 제공되며, 패치 제작자/배포처의 요청에 따라 일부 정보 또는 링크는 표시되지 않을 수 있습니다.
                            한국어 패치 제작자 또는 배포처에서 정보 표시 제외를 원하실 경우, <strong>support@sesl0ver.dev</strong> 로 연락해 주세요.
                        </p>
                    </div>
                </div>

                <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-4">
                    <div class="flex items-start gap-3">
                        <span class="mt-[2px] text-white/60 leading-none select-none">•</span>
                        <p class="text-sm leading-relaxed text-white/75">
                            표시되는 가격/할인 정보는 안정성과 속도를 위해 캐시된 데이터를 활용하고 있습니다.
                            최종 구매 전에는 Steam 공식 스토어의 가격/할인 종료 시점을 확인해 주세요.
                        </p>
                    </div>
                </div>

                <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-4">
                    <div class="flex items-start gap-3">
                        <span class="mt-[2px] text-white/60 leading-none select-none">•</span>
                        <p class="text-sm leading-relaxed text-white/75">
                            버그나 잘못된 정보, 개선이 필요한 부분이 있다면
                            <strong>support@sesl0ver.dev</strong> 로 알려주세요.
                            확인 후 서비스에 반영하겠습니다.
                        </p>
                    </div>
                </div>
            </div>

        </section>



    </div>
{% endblock %}

{% block scripts %}
    <script type="module" src="/assets/app.js"></script>
{% endblock %}
