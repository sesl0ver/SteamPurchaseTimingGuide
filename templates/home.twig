{% extends "layout.twig" %}

{% block content %}
    <section class="rounded-3xl bg-gradient-to-br from-slate-900 to-slate-700 p-8 text-white shadow-sm">
        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
            <div>
                <p class="text-sm/6 text-white/80">Twig + Tailwind</p>
                <h1 class="mt-1 text-3xl font-semibold tracking-tight">인덱스 페이지 스타일 테스트</h1>
                <p class="mt-2 max-w-xl text-white/80">
                    그라데이션, 둥근 모서리, 타이포그래피, 카드, 버튼이 보이면 CSS 적용이 정상입니다.
                </p>
            </div>

            <div class="flex gap-3">
                <a href="/login"
                   class="inline-flex items-center justify-center rounded-xl bg-white px-4 py-2 text-sm font-medium text-slate-900 hover:bg-white/90">
                    로그인 페이지
                </a>
                <a href="/api/login"
                   class="inline-flex items-center justify-center rounded-xl border border-white/30 px-4 py-2 text-sm font-medium text-white hover:bg-white/10">
                    API 엔드포인트(POST)
                </a>
            </div>
        </div>
    </section>

    <div class="mt-8 grid gap-6 md:grid-cols-3">
        <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-900/5">
            <div class="text-sm text-slate-500">상태</div>
            <div class="mt-1 text-lg font-semibold">UI 컴포넌트</div>
            <p class="mt-2 text-sm text-slate-600">카드/텍스트/여백이 자연스럽게 보이면 정상입니다.</p>
            <div class="mt-4 inline-flex rounded-full bg-emerald-50 px-3 py-1 text-xs font-medium text-emerald-700">
                OK
            </div>
        </div>

        <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-900/5">
            <div class="text-sm text-slate-500">테스트</div>
            <div class="mt-1 text-lg font-semibold">버튼/호버</div>
            <p class="mt-2 text-sm text-slate-600">마우스를 올리면 호버 효과가 보입니다.</p>
            <button
                    class="mt-4 inline-flex items-center justify-center rounded-xl bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800">
                버튼 테스트
            </button>
        </div>

        <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-900/5">
            <div class="text-sm text-slate-500">폼</div>
            <div class="mt-1 text-lg font-semibold">입력 필드</div>
            <p class="mt-2 text-sm text-slate-600">포커스 링이 보이면 정상입니다.</p>
            <input
                    class="mt-4 w-full rounded-xl border px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-slate-200"
                    placeholder="포커스 테스트" />
        </div>
    </div>
{% endblock %}
