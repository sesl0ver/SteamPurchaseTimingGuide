{% extends "layout.twig" %}

{% block title %}Steam 로그인{% endblock %}

{% block content %}

    <div class="mx-auto max-w-3xl px-4 py-10">

        <header class="mb-8 flex items-center justify-between">
            <a href="/" class="inline-flex items-center gap-3">
                <img src="/assets/logo.png" alt="logo" class="h-9 w-9 object-contain opacity-95" loading="eager" decoding="async" />
                <div>
                    <h1 class="text-xl font-semibold text-white">Steam 로그인</h1>
                    <p class="mt-0.5 text-xs text-white/60">Steam 계정을 이용해 로그인합니다(OpenID).</p>
                </div>
            </a>

            {% if steam_user %}
                <a href="/auth/logout" class="rounded-2xl border border-[#66c0f4]/25 bg-[#1b2838]/70 px-4 py-2 text-sm font-semibold text-[#66c0f4] hover:bg-[#1b2838]">로그아웃</a>
            {% else %}
                <a href="/" class="rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-2 text-sm text-white/80 hover:bg-white/[0.06]">홈으로</a>
            {% endif %}
        </header>

        {% if error == 'steam_auth_failed' %}
            <div class="mb-6 rounded-2xl border border-rose-400/25 bg-rose-400/10 p-4 text-sm text-rose-200">
                Steam 인증에 실패했습니다. 잠시 후 다시 시도해 주세요.
            </div>
        {% endif %}

        <section class="rounded-3xl border border-white/10 bg-white/[0.03] p-6 sm:p-8">
            {% if steam_user %}
                <div class="flex items-center gap-3">
                    {% if steam_user.avatar %}
                        <img src="{{ steam_user.avatar }}" alt="avatar" class="h-10 w-10 rounded-2xl ring-1 ring-white/10" />
                    {% else %}
                        <div class="grid h-10 w-10 place-items-center rounded-2xl bg-white/10 ring-1 ring-white/10">🙂</div>
                    {% endif %}
                    <div>
                        <p class="text-sm text-white/80">이미 로그인되어 있습니다.</p>
                        <p class="text-base font-semibold text-white">{{ steam_user.persona_name ?: ('SteamID ' ~ steam_user.steam_id) }}</p>
                    </div>
                </div>

                <div class="mt-6 flex flex-col gap-3 sm:flex-row">
                    <a href="/" class="flex-1 rounded-2xl bg-white px-6 py-3 text-center text-sm font-semibold text-neutral-950 hover:bg-white/90">시작 페이지로</a>
                    <a href="/auth/logout" class="flex-1 rounded-2xl border border-[#66c0f4]/25 bg-[#1b2838]/70 px-6 py-3 text-center text-sm font-semibold text-[#66c0f4] hover:bg-[#1b2838]">로그아웃</a>
                </div>

            {% else %}
                <h2 class="text-lg font-semibold text-white">Steam 계정으로 로그인</h2>
                <p class="mt-1 text-sm text-white/60">
                    이 로그인은 <span class="text-white/80">Steam OpenID</span>를 통해 Steam에서 인증을 받은 뒤,
                    이 서비스에 로그인 상태를 저장합니다.
                </p>

                <div class="mt-6 rounded-2xl border border-white/10 bg-white/[0.02] p-5">
                    <p class="text-sm font-semibold text-white/85">개인정보 사용 안내</p>
                    <ul class="mt-2 space-y-2 text-sm text-white/70">
                        <li class="flex gap-2"><span class="text-white/50">•</span><span>저장/사용되는 정보: SteamID(고유 식별자), 프로필 닉네임, 프로필 URL, 아바타 이미지 URL.</span></li>
                        <li class="flex gap-2"><span class="text-white/50">•</span><span>사용 목적: 로그인 상태 유지 및 서비스 이용에 필요한 정보 저장(찜목록)</span></li>
                        <li class="flex gap-2"><span class="text-white/50">•</span><span>비밀번호는 이 서비스에 저장되지 않으며, 인증은 Steam에서만 처리됩니다.</span></li>
                        <li class="flex gap-2"><span class="text-white/50">•</span><span>회원 탈퇴 시 모든 유저 정보는 즉시 삭제되며, 재가입에 제한은 없습니다.</span></li>
                    </ul>
                </div>

                <div class="mt-6">
                    <a
                            href="/auth/steam/start"
                            class="inline-flex w-full items-center justify-center gap-3 rounded-2xl border border-[#66c0f4]/25 bg-[#1b2838]/80 px-6 py-3 text-sm font-semibold text-[#66c0f4] transition-colors hover:bg-[#1b2838]"
                            aria-label="Steam으로 로그인"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 65 65" fill="#fff"><use xlink:href="#B" x=".5" y=".5"/><defs><linearGradient id="A" x2="50%" x1="50%" y2="100%" y1="0%"><stop stop-color="#111d2e" offset="0%"/><stop stop-color="#051839" offset="21.2%"/><stop stop-color="#0a1b48" offset="40.7%"/><stop stop-color="#132e62" offset="58.1%"/><stop stop-color="#144b7e" offset="73.8%"/><stop stop-color="#136497" offset="87.3%"/><stop stop-color="#1387b8" offset="100%"/></linearGradient></defs><symbol id="B"><g><path d="M1.305 41.202C5.259 54.386 17.488 64 31.959 64c17.673 0 32-14.327 32-32s-14.327-32-32-32C15.001 0 1.124 13.193.028 29.874c2.074 3.477 2.879 5.628 1.275 11.328z" fill="url(#A)"/><path d="M30.31 23.985l.003.158-7.83 11.375c-1.268-.058-2.54.165-3.748.662a8.14 8.14 0 0 0-1.498.8L.042 29.893s-.398 6.546 1.26 11.424l12.156 5.016c.6 2.728 2.48 5.12 5.242 6.27a8.88 8.88 0 0 0 11.603-4.782 8.89 8.89 0 0 0 .684-3.656L42.18 36.16l.275.005c6.705 0 12.155-5.466 12.155-12.18s-5.44-12.16-12.155-12.174c-6.702 0-12.155 5.46-12.155 12.174zm-1.88 23.05c-1.454 3.5-5.466 5.147-8.953 3.694a6.84 6.84 0 0 1-3.524-3.362l3.957 1.64a5.04 5.04 0 0 0 6.591-2.719 5.05 5.05 0 0 0-2.715-6.601l-4.1-1.695c1.578-.6 3.372-.62 5.05.077 1.7.703 3 2.027 3.696 3.72s.692 3.56-.01 5.246M42.466 32.1a8.12 8.12 0 0 1-8.098-8.113 8.12 8.12 0 0 1 8.098-8.111 8.12 8.12 0 0 1 8.1 8.111 8.12 8.12 0 0 1-8.1 8.113m-6.068-8.126a6.09 6.09 0 0 1 6.08-6.095c3.355 0 6.084 2.73 6.084 6.095a6.09 6.09 0 0 1-6.084 6.093 6.09 6.09 0 0 1-6.081-6.093z"/></g></symbol></svg>
                        Steam으로 로그인
                    </a>

                    <p class="mt-3 text-xs text-white/45">
                        로그인 버튼을 누르면 Steam 인증 페이지로 이동합니다.
                    </p>
                </div>
            {% endif %}
        </section>

    </div>

{% endblock %}
